rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.keys().hasAll(['fullName', 'shopName', 'email', 'createdAt'])
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.shopName is string
                    && request.resource.data.shopName.size() > 0
                    && request.resource.data.email is string;
      allow update: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.fullName is string
                    && request.resource.data.shopName is string;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Customer subcollection: strictly owned by the parent user
      match /customers/{customerId} {
        allow get: if isOwner(userId) && isValidId(customerId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(customerId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0;
        allow update: if isOwner(userId) && isValidId(customerId)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0;
        allow delete: if isOwner(userId) && isValidId(customerId);
      }

      // Transactions subcollection: strictly owned by the parent user
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(transactionId)
                      && request.resource.data.userId == request.auth.uid
                      && (request.resource.data.type == 'credit' || request.resource.data.type == 'payment')
                      && request.resource.data.amountPaise is int
                      && request.resource.data.amountPaise > 0
                      && request.resource.data.customerName is string;
        allow update: if isOwner(userId) && isValidId(transactionId)
                      && request.resource.data.userId == request.auth.uid
                      && (request.resource.data.type == 'credit' || request.resource.data.type == 'payment')
                      && request.resource.data.amountPaise is int
                      && request.resource.data.amountPaise > 0;
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
